# hivecore gateway (used for both the OpenAI-compatible chat/embeddings API
# and the /systemone structured classification addon)
HIVECORE_BASE_URL=https://hivecore.famnit.upr.si/v1
HIVECORE_API_KEY=your-hivecore-key

# Chat model used to write the final answer
CHAT_MODEL=systemone/Qwen3-4B-Instruct-2507-Q4_K_M

# Embeddings: Ollama-style /api/embed endpoint (bge-m3, 1024-dim)
EMBEDDING_API_URL=http://hivecore.famnit.upr.si:6666/api/embed
EMBEDDING_API_KEY=your-hivecore-key
# optional aliases (same value as EMBEDDING_API_KEY)
EMBEDDING_BEARER_TOKEN=
BEARER_TOKEN=
EMBEDDING_API_MODEL=bge-m3
EMBEDDING_API_TIMEOUT=120
EMBEDDING_BATCH_SIZE=16
EMBEDDING_API_RETRIES=2
EMBEDDING_API_BACKOFF_SEC=1.5

QDRANT_URL=https://da916f8f-ccd6-4579-a765-06648e994f88.us-west-2-0.aws.cloud.qdrant.io:6333/dashboard#/collections/JevTry
# Only needed for Qdrant Cloud (or a server with an API key set); leave empty for local docker
QDRANT_API_KEY=
QDRANT_COLLECTION=support_kb
COLLEAGUES_COLLECTION=colleagues
